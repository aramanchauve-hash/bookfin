# URL de base de l'API Bookfin backend
# Sur Android Emulator, localhost du PC correspond à http://10.0.2.2:3000
# Sur iOS Simulator / Web, localhost du PC correspond à http://localhost:3000
# Sur un téléphone physique (Expo Go sur Wi-Fi local), spécifier l'IP locale de votre machine (ex: http://192.168.1.50:3000)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Utilisateur de développement (optionnel, repli automatique sur le DEFAULT_DEV_USER_ID)
EXPO_PUBLIC_DEV_USER_ID=11111111-1111-1111-1111-111111111111

