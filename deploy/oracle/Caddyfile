{
    # Email utilisé par Caddy pour les notifications Let's Encrypt / ZeroSSL
    # Si non défini, Let's Encrypt fonctionne anonymement
    email {$ACME_EMAIL:}
}

{$DOMAIN::80} {
    reverse_proxy api:3000

    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
        format console
    }
}
