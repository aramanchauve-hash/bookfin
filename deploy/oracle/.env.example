# ==============================================================================
# BOOKFIN — CONFIGURATION ENVIRONNEMENT ORACLE CLOUD (EXEMPLE)
# Copier ce fichier vers .env sur la VM : cp .env.example .env
# Remplacer les valeurs factices par vos secrets générés.
# Ne JAMAIS commiter de fichier .env réel.
# ==============================================================================

# --- Base de données PostgreSQL (Strictement interne, non exposée) ---
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=bookfin
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_SECRET_HERE
POSTGRES_DB=bookfin

# --- HTTPS et Nom de Domaine (Caddy) ---
# Tant qu'aucun domaine DNS n'est pointé vers l'IP Oracle : DOMAIN=:80
# Dès que le domaine pointe vers l'IP Oracle (ex: api.votre-domaine.com) :
# DOMAIN=api.votre-domaine.com
DOMAIN=:80
ACME_EMAIL=admin@example.com

# --- Backend Rust / Axum ---
RUST_LOG=info,bookfin=debug
