# ==============================================================================
# BOOKFIN — CONFIGURATION NEON + RENDER (EXEMPLE)
# Ne JAMAIS commiter de fichier .env avec des credentials réels.
# ==============================================================================

# --- Chaîne de connexion Neon PostgreSQL (avec TLS obligatoire) ---
# En runtime sur Render : utiliser la chaîne pooled (avec -pooler) pour optimiser les connexions.
# Format : postgres://<user>:<password>@<neon-endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgres://bookfin:CHANGE_ME_PASSWORD@ep-bookfin-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Render Port & Runtime ---
# Fourni automatiquement par Render à l'exécution (ex: 10000)
PORT=3000

# --- Tracing & Logs ---
RUST_LOG=info,bookfin=debug
